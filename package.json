{
  "name": "beinong-static-system",
  "private": true,
  "version": "1.0.0",
  "description": "Production-only hardened GitHub Pages packaging for the Beinong Market static system.",
  "scripts": {
    "dev:v2": "next dev web",
    "build:v2": "next build web",
    "typecheck:v2": "tsc -p web/tsconfig.json --noEmit",
    "build:api": "node backend/node-api/build.mjs",
    "typecheck:api": "tsc -p backend/node-api/tsconfig.json",
    "start:api": "node backend/node-api/dist/server.mjs",
    "build:pages": "npm run build:v2 && node tools/build-hardened-pages.mjs",
    "scan:pages": "node tools/scan-all-pages.mjs",
    "verify:provenance": "node tools/verify-provenance.mjs",
    "security:audit": "node tools/security-design-audit.mjs",
    "security:secrets": "node tools/security-secret-scan.mjs",
    "test:e2e:repair": "node tools/e2e-repair-flow.mjs",
    "test:e2e:vehicle": "node tools/e2e-vehicle-dispatch-flow.mjs",
    "test:security-audit": "node --test web/lib/security-audit-sanitize.test.ts",
    "test:app-navigation": "node --test web/lib/app-navigation.test.ts",
    "test:password-policy": "node --test web/lib/password-policy.test.ts",
    "test:auth-consistency": "node tools/auth-consistency-check.mjs",
    "test:perspective-fit": "node --test web/lib/perspective-fit.test.ts",
    "test:floor-consistency": "node tools/floor-consistency-check.mjs",
    "test:schema-contract": "node tools/schema-contract-check.mjs",
    "test:patrol-offline": "node tools/patrol-offline-consistency-check.mjs",
    "test:page-headings": "node --experimental-strip-types tools/system-page-heading-check.mjs",
    "test:button-standard": "node tools/v2-button-standard-check.mjs",
    "test:profile-modal": "node tools/profile-modal-layout-check.mjs",
    "test:login-layout": "node tools/login-layout-check.mjs",
    "test:market-bar-guide": "node tools/market-bar-guide-check.mjs",
    "test:market-movement": "node --experimental-strip-types --test web/lib/market-movement.test.ts",
    "test:market-dashboard-rotation": "node --experimental-strip-types --test web/lib/dashboard-market-rotation.test.ts",
    "test:market-request-cache": "node --experimental-strip-types --test web/lib/request-cache.test.ts",
    "test:market-rollup-performance": "node tools/market-rollup-performance-check.mjs",
    "test:market-stock-signal": "node tools/market-stock-signal-check.mjs",
    "test:market-command-center": "node tools/market-command-center-check.mjs",
    "test:market-interactive-dashboard": "node tools/market-interactive-dashboard-check.mjs",
    "test:backup": "node --test tools/backup-request.test.mjs tools/backup-storage-integrity.test.mjs tools/database-restore.test.mjs && node tools/database-backup-consistency-check.mjs",
    "backup:db": "node tools/database-backup.mjs",
    "backup:verify": "node tools/database-backup-verify.mjs",
    "test": "node --check tools/build-hardened-pages.mjs && npm run test:security-audit && npm run test:app-navigation && npm run test:auth-consistency && npm run test:password-policy && npm run test:floor-consistency && npm run test:perspective-fit && npm run test:schema-contract && npm run test:patrol-offline && npm run test:page-headings && npm run test:button-standard && npm run test:profile-modal && npm run test:login-layout && npm run test:market-bar-guide && npm run test:market-movement && npm run test:market-dashboard-rotation && npm run test:market-request-cache && npm run test:market-rollup-performance && npm run test:market-stock-signal && npm run test:market-command-center && npm run test:market-interactive-dashboard && npm run test:backup && npm run test:market-file-import && npm run test:admin-api && npm run test:local-api-routing && npm run test:weather-api && npm run test:board-notices && npm run test:official-timeout-errors",
    "test:market-file-import": "node --experimental-strip-types --test web/lib/market-file-import.test.ts",
    "test:local-api-routing": "node tools/local-api-routing-check.mjs",
    "test:admin-api": "node tools/admin-api-check.mjs",
    "test:weather-api": "node --test web/lib/weather-api.test.ts",
    "test:board-notices": "node --experimental-strip-types tools/board-notices-check.mjs",
    "test:official-timeout-errors": "node tools/official-document-timeout-error-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "@zxing/browser": "0.2.1",
    "chart.js": "^4.5.1",
    "dxf-parser": "^1.1.2",
    "exceljs": "4.4.0",
    "next": "16.3.0",
    "openseadragon": "5.0.1",
    "qrcode-generator": "^1.5.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "three": "0.171.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.10.2",
    "@types/openseadragon": "5.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.171.0",
    "esbuild": "0.25.12",
    "html-minifier-terser": "7.2.0",
    "parse5": "^8.0.1",
    "terser": "5.49.2",
    "typescript": "5.9.3"
  }
}
